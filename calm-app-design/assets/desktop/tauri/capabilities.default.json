{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the main window needs. Add a permission when a feature needs it — never broad fs or shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    "dialog:allow-open",
    "dialog:allow-save",
    "window-state:default"
  ]
}
